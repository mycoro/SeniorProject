rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection - users can read/write their own profile
    match /users/{userId} {
      // A user can read/write their own profile
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Meal logs subcollection - users can read/write their own meal logs
    match /users/{userId}/mealLogs/{logId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Doctor access: doctors can read patient nutrition data only if they are assigned
    // This assumes each patient user doc contains an `assignedDoctors` array of UIDs
    match /users/{patientId}/mealLogs_readonly/{entryId} {
      allow read: if request.auth != null && (
        request.auth.uid == patientId ||
        (
          // check the requestor is a doctor via their user role
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'healthcare_prof' &&
          // and the patient doc lists the doctor in assignedDoctors
          (get(/databases/$(database)/documents/users/$(patientId)).data.assignedDoctors is list && request.auth.uid in get(/databases/$(database)/documents/users/$(patientId)).data.assignedDoctors)
        )
      );
    }

    // Generic pattern: allow doctors to read patient subcollections if assigned
    match /users/{patientId}/{subcol}/{docId} {
      allow read: if request.auth != null && (
        request.auth.uid == patientId ||
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'healthcare_prof' &&
          (get(/databases/$(database)/documents/users/$(patientId)).data.assignedDoctors is list && request.auth.uid in get(/databases/$(database)/documents/users/$(patientId)).data.assignedDoctors)
        )
      );
      // writes only allowed by the patient themselves (doctors should not write patient meal logs)
      allow write: if request.auth != null && request.auth.uid == patientId;
    }
  }
}

