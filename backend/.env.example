# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
# 
# Steps to get your OpenAI API key:
# 1. Go to https://platform.openai.com/
# 2. Sign up or log in to your account
# 3. Navigate to API Keys section: https://platform.openai.com/api-keys
# 4. Click "Create new secret key"
# 5. Copy the key and paste it below (it starts with "sk-")
# 6. IMPORTANT: Keep this key secret and never commit it to git

OPENAI_API_KEY=your_openai_api_key_here

# Optional: API URL for frontend (leave empty for auto-detection)
# EXPO_PUBLIC_API_URL=http://localhost:3000
