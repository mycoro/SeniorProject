generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Patient {
  id        Int      @id @default(autoincrement())
  uuid      String   @unique @default(uuid()) @map("uuid") // NEW UUID COLUMN
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  meals     Meal[]
  liquids   LiquidIntake[]
}

model Meal {
  id           Int          @id @default(autoincrement())
  patientId    Int          @map("patient_id")
  mealDate     DateTime     @map("meal_date")
  mealCategory MealCategory @map("meal_category")
  foodName     String       @map("food_name")
  calories     Int
  protein      Int
  carbs        Int?
  fiber        Int?
  createdAt    DateTime     @default(now()) @map("created_at")

  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model LiquidIntake {
  id         Int      @id @default(autoincrement())
  patientId  Int      @map("patient_id")
  liquidType String
  intake     Float
  recordedAt DateTime @default(now())

  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

enum MealCategory {
  Breakfast
  Lunch
  Dinner
  Snack
}
